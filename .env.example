# Copy to .env for local runs (never commit the real .env).
# On a host like Render, set these in the dashboard instead.

# From https://trello.com/app-key (the "Key" field).
TRELLO_API_KEY=your_trello_api_key

# A READ-ONLY token — see README.md "Step 1" for the authorize URL.
TRELLO_TOKEN=your_read_only_token

# Unguessable path; the full URL is your only access control in the simple
# setup, so treat it like a password. Example below — generate your own.
MCP_PATH=/mcp-change-this-to-something-random

# Local-only; hosts set PORT themselves.
PORT=8000
